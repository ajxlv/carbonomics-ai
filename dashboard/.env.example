# Copy to .env.local for local development. On Vercel set the same names under Project Settings > Environment Variables.
# All three values are public by design (they end up in the browser). Never put a service-role key or a password here.

# Address of the analysis server (the FastAPI app in /api)
VITE_API_URL=http://localhost:8000
# Supabase project URL and its public anon / publishable key (Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
